{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/light/planos/comparar",
      "destination": "/planos/comparar"
    },
    {
      "source": "/light/planos/comparar/",
      "destination": "/planos/comparar"
    },
    {
      "source": "/light",
      "destination": "/"
    },
    {
      "source": "/light/",
      "destination": "/"
    },
    {
      "source": "/light/:path*",
      "destination": "/:path*"
    }
  ]
}
